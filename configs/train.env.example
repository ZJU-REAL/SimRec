# Run from the repository root:
#   cp configs/train.env.example configs/train.env
#   CONFIG_FILE=configs/train.env bash scripts/train_simrec.sh
#
# Every filesystem path below is relative to this repository. The repository
# contains no data, indexes, checkpoints, credentials, or user information.

# Model, data, and retrieval inputs.
MODEL_NAME=Qwen/Qwen3-4B
SEED=42
TRAIN_DATA=data/processed/amazon_c4/train.jsonl
VAL_DATA=data/processed/amazon_c4/validation.jsonl
TEST_DATA=data/processed/amazon_c4/test.jsonl
AMAZON_C4_SOURCE=data/raw/amazon_c4/amazon_c4.csv
AMAZON_C4_SPLIT=train
SEARCH_INDEX_DIR=data/indexes/dense
SEARCH_BM25_INDEX_DIR=data/indexes/bm25
SEARCH_MODEL_PATH=Qwen/Qwen3-Embedding-4B
SEARCH_DEVICE=cuda
SEARCH_ENCODER_BACKEND=auto

# External simulator (`external`) or shared-parameter shopper/recommender
# rollouts (`self_play`). Keep API credentials in the environment, never here.
SIMREC_USER_SIMULATOR_MODE=external
SIMREC_USER_LLM_BASE_URL=https://api.example.com
SIMREC_USER_LLM_MODEL=Qwen3.6-Plus
SIMREC_USER_LLM_TIMEOUT=60
SIMREC_USER_LLM_TEMPERATURE=0.2
SIMREC_USER_LLM_MAX_TOKENS=220
SIMREC_USER_LLM_ENABLE_THINKING=false
SIMREC_USER_LLM_FALLBACK_ON_ERROR=true
# Used only by `prepare_amazon_c4.py --profile_sources ...`; leave the API key
# in the environment rather than this file.
SIMREC_PROFILE_LLM_BASE_URL=https://api.example.com
SIMREC_PROFILE_LLM_MODEL=Qwen3.6-Plus
SIMREC_PROFILE_LLM_MAX_TOKENS=96
SIMREC_PROFILE_LLM_TEMPERATURE=0.2
SIMREC_PROFILE_LLM_TIMEOUT=60
SIMREC_PROFILE_LLM_MAX_RETRIES=3
SIMREC_PROFILE_LLM_SEED=42
SIMREC_TRAIN_SELF_PLAY_USER=true
SIMREC_SELF_PLAY_USER_REWARD_SHARE=1.0

# Distributed and rollout settings. Change GPU selection locally as needed.
GPUS=0,1
N_GPUS_PER_NODE=2
N_NODES=1
RL_ALG=grpo
STRATEGY=fsdp
ROLLOUT_N=8
AGENT_NUM_WORKERS=1
TRAIN_BATCH_SIZE=8
VAL_BATCH_SIZE=4
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
LOGPROB_MICRO_BATCH_SIZE_PER_GPU=1
GPU_MEMORY_UTILIZATION=0.4
MAX_NUM_SEQS=8
USE_DYNAMIC_BSZ=false
DO_OFFLOAD=true
FREE_CACHE_ENGINE=true
TENSOR_MODEL_PARALLEL_SIZE=1
ENABLE_CHUNKED_PREFILL=false
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=1024
MAX_TURNS=4
MULTI_TURN_CONTEXT_BUFFER=128
ROLLOUT_MAX_MODEL_LEN=3200
MAX_NUM_BATCHED_TOKENS=3200
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=3200
TOOL_CALL_FORMAT=hermes

# Paper GRPO settings.
LR=5e-7
CRITIC_LR=5e-6
KL_COEF=1e-3
KL_LOSS_COEF=0.0
KL_LOSS_TYPE=low_var_kl
ENTROPY_COEFF=0.0
CLIP_RATIO=0.2
TEMPERATURE=1.0
TOP_P=1.0

# Task-aligned retrieval, injection, and reward settings.
SIMREC_SEARCH_MODE=dense
SIMREC_FINAL_RETRIEVAL_MODE=dense
SIMREC_RECALL_EXPANSION_MODE=dense
SIMREC_SEARCH_TOP_K=100
SIMREC_VALIDATION_SEARCH_TOP_K=100
SIMREC_SEARCH_DISPLAY_TOP_K=20
SIMREC_MAX_SEARCHES=3
SIMREC_TRAIN_INJECT_TARGET_ON_MISS=true
SIMREC_VALIDATION_INJECT_TARGET_ON_MISS=false
SIMREC_MIN_USER_TURNS_BEFORE_TARGET_INJECTION=2
SIMREC_VALID_SEARCH_BONUS=0.03
SIMREC_VALID_ITEM_DETAILS_BONUS=0.01
SIMREC_VALID_USER_PREFERENCE_BONUS=0.01
SIMREC_RETRIEVAL_NDCG_REWARD_SCALE=1.0
SIMREC_HIT_AT_1_REWARD=1.0
SIMREC_FORMAT_BONUS=0.01
SIMREC_FEEDBACK_QUERY_NO_CHANGE_PENALTY=0.05
SIMREC_LENGTH_PENALTY_FREE_TURNS=4
SIMREC_LENGTH_PENALTY_PER_TURN=0.02
SIMREC_MAX_LENGTH_PENALTY=0.20
SIMREC_REWARD_NDCG_MODE=paper_multi_target

# Run management. All output paths are repository-relative.
TOTAL_EPOCHS=1
TOTAL_TRAINING_STEPS=200
# `VALIDATION_FREQ` is mapped to verl's `trainer.test_freq`, which runs only
# `VAL_DATA`. `TEST_DATA` is held out and is never passed to the trainer.
SAVE_FREQ=20
VALIDATION_FREQ=20
VAL_BEFORE_TRAIN=false
CHECKPOINT_ROOT=checkpoints
TRAINER_RESUME_MODE=auto
TRAINER_RESUME_FROM_PATH=null
# Held-out evaluation: set EVAL_MODEL_PATH to a loadable merged/exported
# checkpoint and run `bash evaluation/evaluate_simrec.sh`.
EVAL_MODEL_PATH=${EVAL_MODEL_PATH:-}
EVAL_DATA=${EVAL_DATA:-data/processed/amazon_c4/test.jsonl}
RAY_TMP_DIR=ray_tmp
RAY_INCLUDE_DASHBOARD=false
WANDB_MODE=offline
